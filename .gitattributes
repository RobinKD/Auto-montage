# Fins de ligne : les scripts lancés dans le conteneur Linux doivent rester en LF, même
# après un clone sous Windows (core.autocrlf) ; les lanceurs Windows restent en CRLF.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.command text eol=lf
*.applescript text eol=lf
*.desktop.in text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ico binary
*.png binary
*.mp4 binary
*.mov binary
*.iss text eol=crlf
